{
  "name": "vcraft-backend",
  "version": "0.1.0",
  "private": true,
  "description": "vCraft NestJS + MongoDB backend starter",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "build": "npm run build:api && npm run build:web",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "db:dev": "node scripts/mongo-dev.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:api && node --test test/config.test.cjs test/maps.test.cjs",
    "build:api": "nest build",
    "build:web": "vite build --config frontend/vite.config.mjs --configLoader native",
    "web:dev": "vite --config frontend/vite.config.mjs --configLoader native",
    "preseed": "npm run build:api",
    "seed": "node scripts/seed.cjs",
    "pretest:e2e": "npm run build:api",
    "test:e2e": "node --test test/e2e.test.cjs test/seed.test.cjs",
    "dev": "node scripts/dev.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "mongoose": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "helmet": "^8.0.0",
    "@nestjs/jwt": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "zod": "^3.24.0",
    "sharp": "^0.34.0",
    "qrcode": "^1.5.4",
    "express-rate-limit": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "mongodb-memory-server": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.5",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0"
  }
}
