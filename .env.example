NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/vcraft
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PUBLIC_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Cấu hình gửi Email qua Google Gmail (SMTP)
# Lưu ý: SMTP_PASS là "Mật khẩu ứng dụng" (App Password 16 chữ số), không dùng mật khẩu tài khoản Gmail thông thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="vCraft · Sắc mộc Đông Hồ <your-email@gmail.com>"
